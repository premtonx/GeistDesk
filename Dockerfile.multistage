# Optional full multi-stage build (source → dist inside Docker).
# Prefer the default Dockerfile + CI-prebuilt dist/ for production deploys.

FROM node:24-alpine AS builder
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit
COPY . .
ARG VITE_DEMO_MODE=false
ARG VITE_ENABLE_DEMO_LOGIN=false
ARG VITE_BETA_AUTO_ADMIN=false
ARG VITE_OLLAMA_ENDPOINT=
ARG VITE_MASTER_KEY_SALT=
ARG VITE_PUBLIC_APP_URL=
ENV VITE_DEMO_MODE=$VITE_DEMO_MODE \
    VITE_ENABLE_DEMO_LOGIN=$VITE_ENABLE_DEMO_LOGIN \
    VITE_BETA_AUTO_ADMIN=$VITE_BETA_AUTO_ADMIN \
    VITE_OLLAMA_ENDPOINT=$VITE_OLLAMA_ENDPOINT \
    VITE_MASTER_KEY_SALT=$VITE_MASTER_KEY_SALT \
    VITE_PUBLIC_APP_URL=$VITE_PUBLIC_APP_URL \
    NODE_ENV=production
RUN npm run build

FROM node:24-alpine AS runner
WORKDIR /app
ARG BUILD_ID=local
ENV BUILD_ID=$BUILD_ID NODE_ENV=production PORT=3000
COPY package.json package-lock.json .npmrc ./
RUN npm ci --omit=dev --no-audit && npm cache clean --force
COPY --from=builder /app/dist ./dist
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
