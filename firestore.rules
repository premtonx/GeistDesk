rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isVerified() { 
      return request.auth != null && (
        request.auth.token.email_verified == true || 
        (request.auth.token.get('email', '').lower() == "premtonxh@gmail.com")
      ); 
    }
    function isAdmin() { 
      return request.auth != null && (
        (request.auth.token.get('email', '').lower() == "premtonxh@gmail.com") || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidTicket(data) {
      return (data.get('subject', '') is string) && (data.get('subject', '').size() <= 200) &&
             (data.get('status', 'open') in ['open', 'pending', 'resolved', 'closed', 'merged', 'trash']) &&
             (data.get('priority', 'medium') in ['low', 'medium', 'high', 'urgent']) &&
             (data.get('contactId', '') is string) &&
             (data.get('companyId', '') is string) &&
             (data.get('groupId', '') is string) &&
             (data.get('groupName', '') is string) &&
             (data.get('createdAt', request.time) is timestamp);
    }
    function isValidCompany(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.domain is string && data.domain.size() <= 100 &&
             data.branche in ['Tech', 'Finance', 'Healthcare', 'Manufacturing', 'Retail', 'Services', 'Other'] &&
             data.wartungsvertragStatus in ['Active', 'Expired', 'None'] &&
             data.createdAt is timestamp;
    }
    function isValidContact(data) {
      return data.companyId is string &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             (data.get('metadata', {}) is map) &&
             data.createdAt is timestamp;
    }
    function isValidMessage(data) {
      return data.ticketId is string &&
             data.senderId is string &&
             data.senderType in ['customer', 'agent', 'ai'] &&
             data.content is string && data.content.size() <= 5000 &&
             data.createdAt is timestamp;
    }
    function isValidKBArticle(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.category is string &&
             data.visibility in ['Public', 'Private'] &&
             data.authorId is string &&
             data.createdAt is timestamp;
    }
    function isValidTag(data) {
      return data.name is string && data.name.size() <= 50 &&
             data.count is int;
    }
    function isValidCustomer(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.tier in ['Free', 'Pro', 'Enterprise'] &&
             data.status in ['active', 'inactive'] &&
             data.createdAt is timestamp;
    }
    function isValidUser(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['admin', 'agent', 'team_lead', 'customer'] &&
             (data.get('signature', '') is string) &&
             (data.get('visibilityScope', 'all') in ['all', 'group', 'assigned']) &&
             (data.get('isDeactivated', false) is bool) &&
             (data.get('agentType', 'full-time') in ['full-time', 'occasional']) &&
             data.createdAt is timestamp;
    }
    function isValidGroup(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.createdAt is timestamp;
    }
    function isValidGroupMember(data) {
      return isValidId(data.groupId) && isValidId(data.userId) &&
             data.joinedAt is timestamp;
    }
    function isValidRole(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.permissions is map &&
             data.specialPermissions is map &&
             data.createdAt is timestamp;
    }

    // Roles
    function isTeamLead() {
      return isVerified() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'team_lead')
      );
    }
    function isValidLegalViolation(data) {
      return data.agentId is string &&
             data.timestamp is timestamp &&
             data.forbiddenText is string && data.forbiddenText.size() <= 1000 &&
             data.violatedRule is string && data.violatedRule.size() <= 500;
    }
    function isValidNotification(data) {
      return data.userId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.category in ['ticket', 'security', 'system'] &&
             data.read is bool &&
             (data.get('priority', 'low') in ['low', 'medium', 'high']) &&
             data.createdAt is timestamp;
    }

    // Audit Logs: Immutable and Admin-Only Read
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isVerified() && 
                    incoming().actorId == request.auth.uid &&
                    incoming().timestamp == request.time &&
                    incoming().keys().hasAll(['actorId', 'actorEmail', 'module', 'action', 'timestamp']) &&
                    incoming().keys().size() >= 5;
    }

    // Notifications: User-specific alerts
    match /notifications/{notificationId} {
      allow read, list: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidNotification(incoming()) && 
                    (isOwner(incoming().userId) || isAdmin()) &&
                    incoming().createdAt == request.time;
      allow update: if isSignedIn() && isOwner(resource.data.userId) && 
                    isValidNotification(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if isAdmin() || (isSignedIn() && isOwner(resource.data.userId));
    }

    // Compliance Logs: Immutable and Admin-Only Read
    match /compliance_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isVerified() && 
                    incoming().agentId == request.auth.uid &&
                    incoming().timestamp == request.time &&
                    isValidLegalViolation(incoming());
    }

    // Admins Collection (Bootstrapped)
    match /admins/{userId} {
      allow read: if isVerified();
      allow write: if false; 
    }

    // Tickets
    match /tickets/{ticketId} {
      allow read: if isVerified() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid || 
        resource.data.agentId == request.auth.uid
      );
      allow create: if isVerified() && isValidTicket(incoming()) && 
                    incoming().createdAt == request.time &&
                    (incoming().customerId == request.auth.uid || isAdmin());
      allow update: if isVerified() && isValidTicket(incoming()) && (
        isAdmin() || 
        resource.data.agentId == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['activeAgents']) ||
        (resource.data.customerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'description', 'updatedAt']))
      ) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isVerified() && (
          isAdmin() || 
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.agentId == request.auth.uid
        );
        allow create: if isVerified() && isValidMessage(incoming()) && 
                      incoming().ticketId == ticketId &&
                      incoming().createdAt == request.time &&
                      (incoming().senderId == request.auth.uid || incoming().senderType == 'ai');
      }
    }

    // KB Articles
    match /kb_articles/{articleId} {
      allow read: if resource.data.visibility == 'Public' || isVerified();
      allow create: if isVerified() && isValidKBArticle(incoming()) && 
                    incoming().authorId == request.auth.uid &&
                    incoming().createdAt == request.time;
      allow update: if isVerified() && isValidKBArticle(incoming()) && (
        isAdmin() || incoming().authorId == request.auth.uid
      ) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() || (isVerified() && resource.data.authorId == request.auth.uid);
    }

    // KB Tags
    match /tags/{tagId} {
      allow read: if isVerified() || (exists(/databases/$(database)/documents/kb_articles/{articleId}) && get(/databases/$(database)/documents/kb_articles/{articleId}).data.visibility == 'Public'); 
      // Actually tags are simpler: if they are used in a public article, they are public. 
      // But firestore rules don't easily allow checking if 'any' article with this tag is public without a collection group query.
      // Let's simplify: read is allowed for everyone if we want a public help center, but filter in code.
      // Instructions say "The Private articles must be protected behind agent authentication".
      allow read: if true; 
      allow write: if isVerified();
    }

    // Companies
    match /companies/{companyId} {
      allow read: if isVerified();
      allow create: if isVerified() && isValidCompany(incoming()) && 
                    incoming().createdAt == request.time;
      allow update: if isVerified() && isValidCompany(incoming()) && (
        isAdmin() || 
        // Logic for company members could go here if needed
        incoming().diff(existing()).affectedKeys().hasOnly(['wartungsvertragStatus', 'updatedAt'])
      ) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    // Contacts
    match /contacts/{contactId} {
      allow read: if isVerified();
      allow create: if isVerified() && isValidContact(incoming()) && 
                    incoming().createdAt == request.time;
      allow update: if isVerified() && isValidContact(incoming()) && (
        isAdmin() || 
        (resource.data.email == request.auth.token.email)
      ) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isVerified() && (isAdmin() || resource.id == request.auth.uid);
      allow create: if isVerified() && isValidCustomer(incoming()) && 
                    (incoming().email == request.auth.token.email || isAdmin()) &&
                    incoming().createdAt == request.time;
      allow update: if isVerified() && (isAdmin() || resource.id == request.auth.uid) && 
                    isValidCustomer(incoming()) &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    // User Profiles
    // --- CORE PERMISSIONS ---
    match /roles/{roleId} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isVerified();
      allow create: if isVerified() && isOwner(userId) && isValidUser(incoming()) && 
                    incoming().createdAt == request.time &&
                    incoming().role == 'agent'; // Self-register as agent by default
      allow update: if isVerified() && (isAdmin() || isOwner(userId)) && 
                    isValidUser(incoming()) &&
                    (isAdmin() || incoming().role == existing().role) && // Only admin can change role
                    incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isVerified();
      allow create: if isTeamLead() && isValidGroup(incoming()) && incoming().createdAt == request.time;
      allow update: if isTeamLead() && isValidGroup(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
      
      match /members/{memberId} {
        allow read: if isVerified();
        allow write: if isTeamLead();
      }
    }

    // Vaults
    match /vaults/{vaultId} {
      allow read: if isVerified() && (
        isAdmin() || 
        isOwner(existing().createdBy) || 
        (existing().type == 'shared' && request.auth.token.email in existing().sharedWith)
      );
      
      allow create: if isVerified() && 
                    incoming().createdBy == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    incoming().keys().hasAll(['name', 'type', 'createdBy', 'createdAt']) &&
                    incoming().keys().size() >= 4;

      allow update: if isVerified() && (
        isAdmin() || 
        isOwner(existing().createdBy)
      ) && incoming().createdBy == existing().createdBy; // Immutable creator
      
      allow delete: if isVerified() && (isAdmin() || isOwner(existing().createdBy));

      // Credential Items within Vaults
      match /items/{itemId} {
        allow read: if isVerified() && (
          isAdmin() || 
          isOwner(get(/databases/$(database)/documents/vaults/$(vaultId)).data.createdBy) ||
          (get(/databases/$(database)/documents/vaults/$(vaultId)).data.type == 'shared' && 
           request.auth.token.email in get(/databases/$(database)/documents/vaults/$(vaultId)).data.sharedWith)
        );

        allow create: if isVerified() && 
                      incoming().vaultId == vaultId &&
                      incoming().updatedAt == request.time &&
                      isValidId(itemId);

        allow update: if isVerified() && (
          isAdmin() || 
          isOwner(get(/databases/$(database)/documents/vaults/$(vaultId)).data.createdBy) ||
          (get(/databases/$(database)/documents/vaults/$(vaultId)).data.type == 'shared' && 
           request.auth.token.email in get(/databases/$(database)/documents/vaults/$(vaultId)).data.sharedWith)
        ) && incoming().vaultId == existing().vaultId; // Immutable vault link
        
        allow delete: if isVerified() && (
          isAdmin() || 
          isOwner(get(/databases/$(database)/documents/vaults/$(vaultId)).data.createdBy)
        );
      }
    }

    // Phantom Vault (Self-destructing links)
    match /vault_items/{itemId} {
      allow read: if true; // Publicly readable for link recipients
      allow create: if isVerified() && incoming().createdBy == request.auth.uid;
      // Allow update if not burned yet (enables recipients to upload data for 'request' items OR burn for 'secret' items)
      allow update: if (isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid)) || (resource.data.isBurned == false);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /vault_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true; // Allow recipients to log actions like 'burn' or 'upload'
    }

    // Settings
    match /settings/company_schema {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    match /settings/contact_schema {
      allow read: if isVerified();
      allow write: if isAdmin();
    }
  }
}
