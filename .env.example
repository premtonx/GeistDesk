# ==============================================================================
# GeistDesk — environment template
# Copy:  cp .env.example .env
# Or:    ./setup.sh          # fills secrets idempotently
#
# Never commit a real .env. Placeholders starting with replace_with_ are
# regenerated by ./setup.sh.
# ==============================================================================

# ------------------------------------------------------------------------------
# Compose file merge (Traefik production)
# Uncomment so `docker compose up -d` loads the Traefik overlay automatically.
# Requires an external Docker network (default: traefik-public).
# ------------------------------------------------------------------------------
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml

# ------------------------------------------------------------------------------
# Public URL / reverse proxy
# ------------------------------------------------------------------------------
# Hostname Traefik/Caddy will match (Host rule / ACME).
DOMAIN=localhost
DOMAIN_NAME=localhost
PUBLIC_HOSTNAME=localhost
# Canonical public origin (no trailing slash). Use https:// in production.
PUBLIC_APP_URL=http://localhost:5000
# Optional Vite bake-in (compose also passes PUBLIC_APP_URL as VITE_PUBLIC_APP_URL).
# VITE_PUBLIC_APP_URL=http://localhost:5000

# Traefik labels (docker-compose.traefik.yml)
ROUTER_NAME=geistdesk
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
# Let's Encrypt resolver name configured on your Traefik instance
TRAEFIK_CERTRESOLVER=myresolver

# Caddy profile only: host bind for the optional frontend/dev publish helper
HOST_PORT=127.0.0.1:5000

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
# Process listen port inside the container is forced to 5000 by compose.
# For bare-metal `npm run dev` / `npm start`, 5000 is the recommended default.
PORT=5000
# Optional image tag for compose builds
# BUILD_ID=local

# ------------------------------------------------------------------------------
# PostgreSQL 15 + pgvector
# Volume: geistdesk_db_data — stay on pg15 unless you dump/restore.
# ------------------------------------------------------------------------------
POSTGRES_USER=geist_user
POSTGRES_PASSWORD=replace_with_db_password
POSTGRES_DB=geistdesk_prod
# DSN consumed by compose → mapped to container DATABASE_URL
GEISTDESK_DATABASE_URL=postgresql://geist_user:replace_with_db_password@geistdesk-db:5432/geistdesk_prod?sslmode=disable
DATABASE_SSL_INSECURE=false

# ------------------------------------------------------------------------------
# Cryptographic secrets — generate with openssl (never commit real values)
#   JWT:     openssl rand -hex 48
#   Keys:    openssl rand -hex 32
#   Salts:   openssl rand -hex 24
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_openssl_rand_hex_48
VAULT_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
AI_SECRETS_KEY=replace_with_openssl_rand_hex_32
MASTER_KEY_SALT=replace_with_openssl_rand_hex_24
# Must match MASTER_KEY_SALT for client/server KDF alignment
VITE_MASTER_KEY_SALT=replace_with_openssl_rand_hex_24
INBOUND_MAIL_WEBHOOK_SECRET=replace_with_openssl_rand_hex_32
GRAPH_CLIENT_STATE_SECRET=replace_with_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# Inbound mail
# ------------------------------------------------------------------------------
INBOUND_EMAIL_DOMAIN=inbound.localhost
INBOUND_MAIL_FORWARD_DOMAIN=inbound.localhost
EMAIL_INGESTION_INTERVAL_MS=60000
# Native SMTP receiver (gateway publishes INBOUND_SMTP_HOST_PORT → container port)
INBOUND_SMTP_ENABLED=true
INBOUND_SMTP_PORT=25
INBOUND_SMTP_HOST_PORT=25
INBOUND_SMTP_BIND=0.0.0.0
INBOUND_SMTP_HOSTNAME=
INBOUND_SMTP_MAX_BYTES=26214400
# Optional outbound SMTP helpers (UI/module-config can override)
SMTP_HOST=
SMTP_USER=
MAIL_DISPATCH_URL=

# ------------------------------------------------------------------------------
# Document / KB storage paths (inside the container)
# ------------------------------------------------------------------------------
DOCUMENT_STORAGE_DIR=/app/storage/documents
KB_SOURCES_ROOT=/data/sources
# KB_EXTERNAL_SYNC_INTERVAL_MS=300000

# ------------------------------------------------------------------------------
# AI providers (also configurable in Admin Hub → Kern-KI)
# ------------------------------------------------------------------------------
OLLAMA_ENDPOINT=
VITE_OLLAMA_ENDPOINT=
OLLAMA_MODEL=
LOCAL_EMBEDDING_ENDPOINT=http://host.docker.internal:8080
LOCAL_EMBEDDING_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
VECTOR_BACKFILL_BATCH=25

# ------------------------------------------------------------------------------
# SSO / Microsoft Entra / OIDC (optional)
# ------------------------------------------------------------------------------
MICROSOFT_PROVIDER_CLIENT_ID=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# ------------------------------------------------------------------------------
# Microsoft Graph / Teams bot (optional)
# ------------------------------------------------------------------------------
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppType=
MicrosoftAppTenantId=

# ------------------------------------------------------------------------------
# Hardening / demo flags (keep false in production)
# ------------------------------------------------------------------------------
BETA_AUTO_ADMIN=false
VITE_BETA_AUTO_ADMIN=false
ENABLE_DEMO_LOGIN=false
VITE_ENABLE_DEMO_LOGIN=false
VITE_DEMO_MODE=false
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_SANDBOX=false
