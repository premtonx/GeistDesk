# ==============================================================================
# GeistDesk — environment template
# Copy is optional: `./setup.sh` creates `.env` from this file and fills secrets.
# Docker Compose reads `.env` automatically. Never edit docker-compose.yml.
# ==============================================================================

# -----------------------------------------------------------------------------
# Public URL / reverse proxy (used by Traefik labels — no sed required)
# -----------------------------------------------------------------------------
# Hostname only (no scheme). Traefik Host(`${DOMAIN_NAME:-localhost}`).
DOMAIN_NAME=localhost
# Full public origin used by the app (cookies, redirects, inbound mail links).
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_HOSTNAME=localhost
# Host port published as localhost:<HOST_PORT> → container :3000
HOST_PORT=3000
# Traefik router / service prefix. Production can pin e.g. geistdesk-sso.
ROUTER_NAME=geistdesk
# External Docker network shared with Traefik.
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=myresolver

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL (bundled compose service)
# -----------------------------------------------------------------------------
POSTGRES_USER=geist_user
# Leave empty for ./setup.sh to generate a random password.
# Existing long-lived volumes that used geist_password keep working via compose
# fallback — do not change this on an already-initialized volume.
POSTGRES_PASSWORD=
POSTGRES_DB=geistdesk_prod
# Optional override for managed Postgres. setup.sh writes this to match POSTGRES_*.
# GEISTDESK_DATABASE_URL=postgresql://geist_user:<password>@geistdesk-db:5432/geistdesk_prod?sslmode=disable
GEISTDESK_DATABASE_URL=
DATABASE_SSL_INSECURE=false

# -----------------------------------------------------------------------------
# Core secrets — leave empty; ./setup.sh generates cryptographically secure values
#   POSTGRES_PASSWORD            openssl rand -hex 16
#   JWT_SECRET                   openssl rand -hex 48
#   MASTER_KEY_SALT              openssl rand -hex 24
#   VAULT_ENCRYPTION_KEY         openssl rand -hex 32   (64 hex chars = 32 bytes)
#   INBOUND_MAIL_WEBHOOK_SECRET  openssl rand -hex 32
# Existing keys are never overwritten.
# -----------------------------------------------------------------------------
JWT_SECRET=
VAULT_ENCRYPTION_KEY=
# Optional vault Argon2 pepper (set only on a fresh install before first unlock).
# VITE_MASTER_KEY_SALT is set to the same value by setup.sh for client derivation.
MASTER_KEY_SALT=
VITE_MASTER_KEY_SALT=
AI_SECRETS_KEY=

# -----------------------------------------------------------------------------
# Inbound mail / Postal webhook (required for email-to-ticket)
# -----------------------------------------------------------------------------
INBOUND_MAIL_WEBHOOK_SECRET=
# Canonical inbound forwarding domain (help-{slug}@<domain>). Loopback values
# (localhost) are ignored and the safe default inbound.geistai.eu is used.
INBOUND_EMAIL_DOMAIN=
INBOUND_MAIL_FORWARD_DOMAIN=
EMAIL_INGESTION_INTERVAL_MS=60000
# Optional platform-wide DKIM public TXT (otherwise a per-channel RSA key is generated):
# MAIL_DKIM_SELECTOR=geist
# MAIL_DKIM_TXT_VALUE=v=DKIM1; k=rsa; p=...
# Outbound From when domain is unverified:
# MAIL_FROM_ADDRESS=noreply@localhost
# MAIL_FROM_NAME=GeistDesk Support

# Outbound mail (optional — agent replies save to DB when unset)
SMTP_HOST=
SMTP_USER=
MAIL_DISPATCH_URL=

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
OLLAMA_ENDPOINT=
VITE_OLLAMA_ENDPOINT=
OLLAMA_MODEL=
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
# RAG embeddings (pgvector KnowledgeEmbedding — 1536 dims)
# Uses the same credentials as the KI orchestrator when possible:
#   OpenAI secret / OPENAI_API_KEY
#   Azure OpenAI secret / AZURE_OPENAI_* (+ AZURE_OPENAI_EMBEDDING_DEPLOYMENT)
#   Google secret / GEMINI_API_KEY
#   Local Ollama or OpenAI-compat gateway via OLLAMA_ENDPOINT / Admin endpointUrl
# Claude/Anthropic has no embedding API and is skipped automatically.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=
# openai | azure_openai | google | ollama | openai_compat  (empty = auto from provider priority)
EMBEDDING_MODEL=
# defaults: text-embedding-3-small (OpenAI/Azure), text-embedding-004 (Gemini), nomic-embed-text (Ollama)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
VECTOR_BACKFILL_BATCH=25

# -----------------------------------------------------------------------------
# OIDC / Microsoft Entra SSO
# -----------------------------------------------------------------------------
MICROSOFT_PROVIDER_CLIENT_ID=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Microsoft Graph / Teams bot
# -----------------------------------------------------------------------------
GRAPH_CLIENT_STATE_SECRET=
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppType=
MicrosoftAppTenantId=

# -----------------------------------------------------------------------------
# Demo / production simulation (opt-in)
# POST /api/demo/seed (SYSTEM_ADMIN) or `npm run seed:demo` fills dashboard KPIs,
# GeistVault catalog, and GeistExchange sessions. Never runs on container boot
# unless ENABLE_DEMO_LOGIN is set on a non-production runtime.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Hardening (production defaults)
# -----------------------------------------------------------------------------
BETA_AUTO_ADMIN=false
VITE_BETA_AUTO_ADMIN=false
# Showcase demo login — explicit non-production opt-in only.
# Ignored (and refused) whenever NODE_ENV=production or a production Vite build.
ENABLE_DEMO_LOGIN=false
VITE_ENABLE_DEMO_LOGIN=false
# Legacy client flag; no longer enables the login button.
VITE_DEMO_MODE=false
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_SANDBOX=false
