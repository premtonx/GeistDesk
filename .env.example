# ==============================================================================
# GeistDesk — Environment Template (.env.example)
# Copy to .env or run ./setup.sh to auto-fill secrets.
# ==============================================================================

# Enable Traefik integration by default if running with Traefik:
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml

# -----------------------------------------------------------------------------
# Public URL / Reverse Proxy
# -----------------------------------------------------------------------------
DOMAIN_NAME=localhost
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_HOSTNAME=localhost
INBOUND_EMAIL_DOMAIN=inbound.localhost
ROUTER_NAME=geistdesk
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=myresolver
HOST_PORT=127.0.0.1:3000

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL (pgvector)
# -----------------------------------------------------------------------------
POSTGRES_USER=geist_user
POSTGRES_PASSWORD=replace_with_db_password
POSTGRES_DB=geistdesk_prod
GEISTDESK_DATABASE_URL=postgresql://geist_user:replace_with_db_password@geistdesk-db:5432/geistdesk_prod?sslmode=disable
DATABASE_SSL_INSECURE=false

# -----------------------------------------------------------------------------
# Core Encryption & Secrets (openssl rand -hex <bytes>)
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_openssl_rand_hex_48
VAULT_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
AI_SECRETS_KEY=replace_with_openssl_rand_hex_32
MASTER_KEY_SALT=replace_with_openssl_rand_hex_24
VITE_MASTER_KEY_SALT=replace_with_openssl_rand_hex_24
INBOUND_MAIL_WEBHOOK_SECRET=replace_with_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Inbound Mail
# -----------------------------------------------------------------------------
INBOUND_MAIL_FORWARD_DOMAIN=inbound.localhost
EMAIL_INGESTION_INTERVAL_MS=60000
SMTP_HOST=
SMTP_USER=
MAIL_DISPATCH_URL=

# -----------------------------------------------------------------------------
# AI Providers (Configurable via UI or here)
# -----------------------------------------------------------------------------
OLLAMA_ENDPOINT=
VITE_OLLAMA_ENDPOINT=
OLLAMA_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
VECTOR_BACKFILL_BATCH=25

# -----------------------------------------------------------------------------
# SSO / Microsoft Entra / OIDC (Optional)
# -----------------------------------------------------------------------------
MICROSOFT_PROVIDER_CLIENT_ID=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Microsoft Graph / Teams Bot (Optional)
# -----------------------------------------------------------------------------
GRAPH_CLIENT_STATE_SECRET=
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppType=
MicrosoftAppTenantId=

# -----------------------------------------------------------------------------
# Hardening
# -----------------------------------------------------------------------------
BETA_AUTO_ADMIN=false
VITE_BETA_AUTO_ADMIN=false
ENABLE_DEMO_LOGIN=false
VITE_ENABLE_DEMO_LOGIN=false
VITE_DEMO_MODE=false
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_SANDBOX=false
