# ==============================================================================
# GEISTDESK — ENTERPRISE PILOT ENVIRONMENT TEMPLATE
# Copy to .env and fill every value marked REQUIRED before `docker compose up`.
# ==============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST_PORT=3000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_HOSTNAME=app.example.com

# -----------------------------------------------------------------------------
# PostgreSQL (bundled compose service)
# -----------------------------------------------------------------------------
POSTGRES_USER=geist_user
# Default geist_password matches long-lived production volumes — change only for NEW volumes.
POSTGRES_PASSWORD=geist_password
POSTGRES_DB=geistdesk_prod
# Defaults to bundled DB credentials when unset in compose; set explicitly for managed Postgres:
DATABASE_URL=postgresql://geist_user:geist_password@geistdesk-db:5432/geistdesk_prod?sslmode=disable
DATABASE_SSL_INSECURE=false

# -----------------------------------------------------------------------------
# Core secrets (REQUIRED)
# Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=
VAULT_ENCRYPTION_KEY=
# Optional vault Argon2 pepper (set ONLY on fresh installs before first unlock).
# Also bake into the image via VITE_MASTER_KEY_SALT for client-side derivation.
MASTER_KEY_SALT=
VITE_MASTER_KEY_SALT=
AI_SECRETS_KEY=

# -----------------------------------------------------------------------------
# Inbound mail / Postal webhook (REQUIRED for email-to-ticket)
# -----------------------------------------------------------------------------
INBOUND_MAIL_WEBHOOK_SECRET=
INBOUND_MAIL_FORWARD_DOMAIN=app.premtonx.cloud
EMAIL_INGESTION_INTERVAL_MS=60000

# Outbound mail (optional — agent replies save to DB when unset)
SMTP_HOST=
SMTP_USER=
MAIL_DISPATCH_URL=

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
OLLAMA_ENDPOINT=
VITE_OLLAMA_ENDPOINT=
OLLAMA_MODEL=
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01

# -----------------------------------------------------------------------------
# OIDC / Microsoft Entra SSO
# -----------------------------------------------------------------------------
MICROSOFT_PROVIDER_CLIENT_ID=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Microsoft Graph / Teams bot
# -----------------------------------------------------------------------------
GRAPH_CLIENT_STATE_SECRET=
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppType=
MicrosoftAppTenantId=

# -----------------------------------------------------------------------------
# Hardening (production defaults)
# -----------------------------------------------------------------------------
BETA_AUTO_ADMIN=false
VITE_BETA_AUTO_ADMIN=false
VITE_DEMO_MODE=false
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_SANDBOX=false
