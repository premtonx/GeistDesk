    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/db/migrate.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/migrate.cjs && esbuild src/db/seed.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/seed.cjs",
    "build:strict": "npm run lint && node scripts/verify-no-react-namespace.mjs && npm run build && node scripts/verify-production-build.mjs",
    "verify:license": "node scripts/verify-license-compliance.mjs",
    "verify:hybrid-crypto": "tsx scripts/verify-hybrid-crypto.mjs",
    "verify:release": "node scripts/verify-license-compliance.mjs && node scripts/verify-no-react-namespace.mjs && node scripts/verify-production-build.mjs && node scripts/verify-server-bundle.mjs && npx tsx scripts/verify-exchange-secret-crypto.mjs && npx tsx scripts/verify-vault-secret-store.mjs && npx tsx scripts/verify-process-value-mutations.mjs",
    "start": "node dist/server.cjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/migrate.cjs",
    "db:deploy": "npm run db:migrate",
    "db:deploy:prod": "npm run db:migrate:prod",
    "db:prisma:migrate": "prisma migrate deploy",
    "db:prisma:generate": "prisma generate",
    "vectors:backfill": "tsx scripts/backfill-vectors.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:prod": "node dist/seed.cjs",
    "prod:bootstrap": "npm run db:deploy:prod && npm run seed:prod",
    "prod:start": "npm run prod:bootstrap && node dist/server.cjs",
    "start:prod": "npm run prod:start",
    "lint": "tsc --noEmit",
    "test:lifecycle": "tsx scripts/test-ai-lifecycle.ts"
  }
}
